
  github-live:
    url: https://api.githubcopilot.com/mcp/
    headers:
      Authorization: "Bearer ${GITHUB_MCP_TOKEN}"
      X-MCP-Toolsets: "repos,pull_requests"
      X-MCP-Readonly: "true"
      X-MCP-Lockdown: "true"
    enabled: true
    timeout: 120
    connect_timeout: 60
    supports_parallel_tool_calls: false
